# Nom affiché sur le site et dans les PDF
SITE_NAME=Cabinet de lecture
# Lettres du monogramme (par défaut : initiales du nom)
MONOGRAM=CL

# Le serveur Node n'écoute qu'en local : Nginx fait l'intermédiaire
HOST=127.0.0.1
PORT=3000

# Passer à 1 une fois le site servi en HTTPS
COOKIE_SECURE=0

# Facultatif : clé d'API Google Books (augmente le quota de recherche des couvertures)
# GOOGLE_BOOKS_KEY=
